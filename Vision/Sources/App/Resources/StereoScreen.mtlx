<?xml version="1.0"?>
<!--
  The screen material: one surface that shows a different picture to each eye.

  This is the only part of the stereo path that is not plain Metal, and it is
  here because visionOS does not have CustomMaterial. On macOS and iOS a surface
  shader would do this in six lines; on visionOS CustomMaterial is marked
  unavailable, and the supported way to branch on which eye is being drawn is
  the RealityKit MaterialX node realitykit_geometry_switch_cameraindex.

  The warp itself does not happen here. Both eye views are already finished, in
  Metal, at video rate, by StereoWarpRenderer. All this material does is choose
  between two textures, ninety times a second, which is the cheapest thing a
  fragment shader can be asked to do.

  Unlit, and tone mapping off: the picture is the picture. A film that has been
  graded once should not be graded again on the way to the eye.
-->
<materialx version="1.38">

  <nodegraph name="EyeSelect">

    <image name="leftSample" type="color3">
      <input name="file" type="filename" interfacename="LeftEye" />
    </image>

    <image name="rightSample" type="color3">
      <input name="file" type="filename" interfacename="RightEye" />
    </image>

    <realitykit_geometry_switch_cameraindex name="eyeSwitch" type="color3">
      <!-- Mono falls back to the left eye, which is the one that was never
           synthesized. Anywhere there is only one camera, the honest answer is
           the frame exactly as filmed. -->
      <input name="mono" type="color3" nodename="leftSample" />
      <input name="left" type="color3" nodename="leftSample" />
      <input name="right" type="color3" nodename="rightSample" />
    </realitykit_geometry_switch_cameraindex>

    <output name="out" type="color3" nodename="eyeSwitch" />
  </nodegraph>

  <realitykit_unlit_surfaceshader name="screenSurface" type="surfaceshader">
    <input name="color" type="color3" nodegraph="EyeSelect" output="out" />
    <input name="opacity" type="float" value="1" />
    <input name="applyPostProcessToneMap" type="boolean" value="false" />
  </realitykit_unlit_surfaceshader>

  <surfacematerial name="StereoScreen" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="screenSurface" />
  </surfacematerial>

</materialx>
